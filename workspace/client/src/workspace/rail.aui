Page ChatRail
  Image src="img/my_chat.svg" alt="Chat"
  Section name=primary-navigation
    Button name=navigation value=chats icon=chat_bubble action=chats "Chats"
    Button name=navigation value=new-chat icon=add_comment action=new-chat "New chat"
    Button name=navigation value=archive icon=archive action=archive "Archived"
    Button name=navigation value=profile icon=person action=profile "Profile"
  Section name=secondary-navigation
    Button name=navigation value=settings icon=settings action=settings "Settings"
    Button name=navigation value=appearance icon=contrast action=appearance "Appearance"
    If condition=$workspace
      Button name=navigation value=workspace icon=apps action=workspace "Workspace"
